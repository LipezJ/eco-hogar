DATABASE_URL=mysql://un_usr:una_clave@localhost:3306/eco_hogar
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=un_usr
DATABASE_PASSWORD=una_clave
DATABASE_NAME=eco_hogar

VITE_API_URL=http://localhost:3000

PORT=3000

# Endpoints de desarrollo (solo usar en local)
ENABLE_DEV_ENDPOINTS=false

# Renovación automática de recibos
# BILL_RENEW_DISABLED=true desactiva el job (por defecto corre siempre)
# BILL_RENEW_CRON usa la sintaxis estándar de node-cron (min hora día mes díaSemana)
# BILL_RENEW_TZ define la zona horaria opcional (ej: America/Bogota)
# Ejemplo: correr todos los días a las 03:00 hora local por defecto
# BILL_RENEW_CRON=0 3 * * *
BILL_RENEW_DISABLED=false
BILL_RENEW_CRON=0 3 * * *
# BILL_RENEW_TZ=America/Bogota

# Notificaciones automáticas
NOTIFICATION_DISABLED=false
NOTIFICATION_CRON=0 8 * * *
NOTIFICATION_DUE_SOON_DAYS=3
# NOTIFICATION_TZ=America/Bogota
